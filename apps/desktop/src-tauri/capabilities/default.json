{
  "identifier": "default",
  "description": "Hearth's own IPC only: its commands and the event listener. No plugins, no http, shell or fs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-version",
    "allow-list-agents",
    "allow-usage-summary",
    "allow-list-projects",
    "allow-add-project",
    "allow-list-threads",
    "allow-worktree-info",
    "allow-create-thread",
    "allow-load-thread",
    "allow-review-turns",
    "allow-start-worktree-review",
    "allow-worktree-diff-files",
    "allow-worktree-diff-file",
    "allow-release-worktree-review",
    "allow-turn-diff-files",
    "allow-turn-diff-file",
    "allow-archive-thread",
    "allow-restore-thread",
    "allow-cleanup-path",
    "allow-remove-thread-worktree",
    "allow-delete-thread-branch",
    "allow-list-thread-models",
    "allow-set-thread-model",
    "allow-draft-handoff",
    "allow-start-handoff",
    "allow-send-message",
    "allow-answer-approval",
    "allow-cancel-turn",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
